# TaskCanvas PHP API 환경 설정 예시
# 이 파일을 .env 로 복사한 뒤 학교 PC 환경에 맞게 수정합니다. .env 는 Git에 올리지 않습니다.

# MySQL / MariaDB 접속 정보
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskcanvas
DB_USER=root
DB_PASS=

# 게스트 세션 쿠키 이름과 유효 시간(초)
SESSION_COOKIE=tc_session
SESSION_TTL=43200

# Socket.IO 접속 티켓 유효 시간(초)
TICKET_TTL=60

# 게스트 입장·작업실 만들기 요청 제한: 같은 IP에서 RATE_WINDOW 초 동안 허용하는 시도 횟수
RATE_LIMIT=20
RATE_WINDOW=600

# 1 이면 누구나 소개 화면에서 작업실을 직접 만들 수 있음. 0 이면 초대 코드로만 입장(작업실은 bin/create-project.php 로 만듦)
ALLOW_WORKSPACE_CREATE=1

# 관리자가 화면에서 작업실을 지울 수 있게 할지(1: 허용, 0: 끔 → 지우려면 시연 초기화만 가능)
ALLOW_WORKSPACE_DELETE=1

# HTTPS 로 서비스할 때 1 로 변경 (쿠키 Secure 속성)
COOKIE_SECURE=0

# 1 이면 오류 응답에 상세 메시지 포함 (개발용)
APP_DEBUG=1

# 이미지 저장 폴더 (php-api 기준 상대 경로 또는 절대 경로). 웹 루트 밖이어야 하며 Git 제외
UPLOAD_DIR=storage/uploads

# 파일당 최대 업로드 크기(바이트). php.ini 의 upload_max_filesize/post_max_size 도 이 값 이상이어야 함
MAX_UPLOAD_BYTES=10485760
