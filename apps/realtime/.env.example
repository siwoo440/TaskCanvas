# TaskCanvas 실시간 서버 환경 설정 예시 — .env 로 복사해서 사용 (.env 는 Git 제외)

# Socket.IO 수신 포트 (학교 PC 방화벽 허용 필요)
PORT=3001

# PHP API 와 같은 DB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskcanvas
DB_USER=root
DB_PASS=

# 실시간 서버에 붙을 수 있는 브라우저 출처
#   auto : 이 서버와 같은 호스트(IP·이름)에서 열린 페이지만 허용(기본). 포트는 달라도 되므로 서버 IP 가 바뀌어도 고칠 필요 없음
#   *    : 모든 출처 허용(개발용)
#   목록 : http://192.168.0.10:8080,http://192.168.0.10 처럼 쉼표로 나열한 출처만 허용
CORS_ORIGIN=auto

# 커서 중계 최소 간격(ms) — 33 이면 약 30Hz
CURSOR_INTERVAL_MS=33

# 펜 한 획의 최대 좌표 수
MAX_STROKE_POINTS=5000

# 객체 선점 잠금 유효 시간(ms). 이동 중 갱신되며 만료·연결 종료 시 자동 해제
LOCK_TTL_MS=30000

# 보드 삭제·이름 변경 감시 주기(ms). 작업실에서 바뀐 내용을 보드 안 참여자에게 알리는 간격
BOARD_SWEEP_MS=5000

# 연결 하나가 보낼 수 있는 요청 수. 통에 BURST 개가 차 있다가 요청마다 하나씩 줄고 1초에 PER_SEC 개씩 다시 찹니다. BURST 를 0 으로 두면 제한하지 않습니다
#   SAVE  : 응답을 돌려주는 요청(참여·잠금·저장·삭제·업무·연결선·선택 알림). 넘치면 RATE_LIMITED 로 거절
#   RELAY : 이동·펜 미리보기 중계. 넘치면 조용히 버림(확정 저장에는 영향 없음)
RATE_SAVE_BURST=300
RATE_SAVE_PER_SEC=50
RATE_RELAY_BURST=1200
RATE_RELAY_PER_SEC=600
