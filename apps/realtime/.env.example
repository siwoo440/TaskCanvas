# TaskCanvas 실시간 서버 환경 설정 예시 — .env 로 복사해서 사용 (.env 는 Git 제외)

# Socket.IO 수신 포트 (학교 PC 방화벽 허용 필요)
PORT=3001

# PHP API 와 같은 DB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskcanvas
DB_USER=root
DB_PASS=

# 허용할 브라우저 출처. * 는 개발용, 운영 시 http://서버IP 형식으로 제한
CORS_ORIGIN=*

# 커서 중계 최소 간격(ms) — 33 이면 약 30Hz
CURSOR_INTERVAL_MS=33

# 펜 한 획의 최대 좌표 수
MAX_STROKE_POINTS=5000
